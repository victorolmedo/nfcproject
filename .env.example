APP_NAME=LoyaltyPass
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


###############################################################################
# LOYALTYPASS
###############################################################################

# Dominio raiz para resolver tenants por subdominio (cafe-aurora.<root>)
LOYALTYPASS_ROOT_DOMAIN=localhost:8000
# subdomain | header | path
LOYALTYPASS_TENANT_DRIVER=subdomain

# URL publica de la API que consumen los pases
LOYALTYPASS_PUBLIC_API_URL=http://localhost:8000/api/v1

# Ventana de validez del QR dinamico, en minutos
LOYALTYPASS_QR_TTL_MINUTES=4

# --- Google Wallet (clase Loyalty, sin costo por pase) ---
# https://developers.google.com/wallet/loyalty
GOOGLE_WALLET_PROJECT_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_WEBHOOK_URL=

# --- Apple Wallet (firmado en servidor, sin librerias de pago) ---
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.loyaltypass.cafe
APPLE_PASS_CERT_PATH=
APPLE_PASS_KEY_PATH=
APPLE_WWDR_CERT_PATH=
APPLE_WEBSERVICE_AUTH_SECRET=
APPLE_PREVIOUS_WEBSERVICE_AUTH_SECRET=
